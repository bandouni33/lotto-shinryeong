{
  "expo": {
    "name": "로또신령",
    "slug": "bandouni",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "ios": {
      "bundleIdentifier": "com.bandouni.lottoshinryeong",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "로또 용지의 QR코드를 촬영해서 번호를 자동으로 입력하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#2a2438"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bandouni.lottoshinryeong"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2a2438"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "로또 용지의 QR코드를 촬영해서 번호를 자동으로 입력하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aee8ec95-1912-43b7-bc3e-ce73699e8cd9"
      }
    },
    "owner": "bandounis-team"
  }
}
