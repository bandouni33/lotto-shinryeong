# ── 카카오 OAuth (실제 간편인증) ─────────────────────────────────────────
# 1) https://developers.kakao.com 에서 앱 생성
# 2) [카카오 로그인] 활성화 → Redirect URI 등록 (아래와 동일하게)
# 3) [앱 키] REST API 키 → KAKAO_REST_API_KEY
# 4) [카카오 로그인] 보안 → Client Secret 사용 시 KAKAO_CLIENT_SECRET 입력
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# PC 공인 IP 접속 시 run_server.ps1 기본값과 맞출 것
KAKAO_REDIRECT_URI=http://210.99.230.83:8501
# 로컬 개발용으로는 Kakao 콘솔에 http://localhost:8501 도 추가 등록

# ── PASS / 금융인증서 (사업자 계약·키 발급 후) ───────────────────────────
PASS_CLIENT_ID=
PASS_REDIRECT_URI=http://210.99.230.83:8501
PASS_AUTH_URL=
PASS_TOKEN_URL=
FINCERT_CLIENT_ID=
FINCERT_REDIRECT_URI=http://210.99.230.83:8501
FINCERT_AUTH_URL=

# ── 토스페이먼츠 적립금 충전 (2026-09-19, Task #13) ───────────────────────
# 1) https://developers.tosspayments.com 가입 → 내 개발자센터
# 2) [API 키] 메뉴에서 테스트 클라이언트 키/시크릿 키 확인(계약 전에도
#    제한된 테스트 키를 먼저 받을 수 있음 — 공식 문서 확인)
# 3) 아래 두 값을 채우면 즉시 Mock 결제 버튼이 사라지고 실제 결제창이 뜬다
#    (wallet_db.pg_configured() 참고 — 별도 스위치 없음)
# 4) 정식 계약 확정 후에는 이 두 값만 라이브 키로 교체하면 됨(코드 변경 불필요)
# 주의: 시크릿 키는 절대 코드/깃에 커밋하지 말 것 — 이 .env(로컬)나
# Streamlit Cloud secrets에만 넣을 것.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── Google Play 인앱결제 (2026-09-25, google_play_pg.py) ──────────────────
# 1) Google Cloud Console → IAM 및 관리자 → 서비스 계정 → lotto-play-billing
#    → "키" 탭 → 키 추가 → JSON → 다운로드된 파일을 텍스트 에디터로 열어서
#    그 안의 JSON 전체 내용을 통째로 복사해 아래 한 줄로(또는 Streamlit Cloud
#    secrets엔 여러 줄 문자열로) 붙여넣는다 — 파일 경로가 아니라 내용 자체를
#    저장한다(Streamlit Cloud엔 파일을 따로 올릴 방법이 없음).
# 2) 이 서비스 계정은 Play Console "사용자 및 권한"에 "재무 데이터, 주문,
#    취소 설문조사 응답 보기" + "주문 및 정기 결제 관리" 권한으로 이미
#    초대돼 있어야 한다(2026-09-25 완료).
# 주의: TOSS_SECRET_KEY와 마찬가지로 절대 코드/깃에 커밋하지 말 것.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ── 알리고 SMS (https://smartsms.aligo.in) ───────────────────────────────
# API 연동 정보 → 문자발송 API 키 / 가입 ID / 사전 등록 발신번호
# sms_sender.py SMS_ENABLED=True + 3개 키 설정 시 실발송 (SENT/WAIT)
# SMS_ENABLED=False(기본): 화면 배너 안내 + sms_queue BANNER_ONLY
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 개발용 Mock 인증: 1=키 없을 때 가짜 로그인 허용, 0=실 OAuth만 허용
LOTTO_DEV_MOCK_AUTH=0
